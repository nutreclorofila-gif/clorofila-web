{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm audit)",
      "Bash(npm run:*)",
      "Bash(node scripts/:*)",
      "Bash(npx html-validate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- .)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && [ -d node_modules ] || npm ci --silent",
            "timeout": 300,
            "statusMessage": "Instalando dependencias del proyecto..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "entrada=$(cat); case \"$entrada\" in *'git commit'*) ;; *) exit 0 ;; esac; npm test >/tmp/claude-npm-test.log 2>&1 || { echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"permissionDecision\\\":\\\"deny\\\",\\\"permissionDecisionReason\\\":\\\"npm test fallo: no se puede commitear con el sitio roto. Detalle en /tmp/claude-npm-test.log\\\"}}\"; }",
            "timeout": 120,
            "statusMessage": "Revisando el sitio antes de commitear..."
          }
        ]
      }
    ]
  }
}
